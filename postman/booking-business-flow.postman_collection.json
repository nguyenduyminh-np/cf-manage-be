  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function pad(n){ return String(n).padStart(2, '0'); }",
          "function toLocalDateTime(date){",
          "  return date.getFullYear() + '-' + pad(date.getMonth() + 1) + '-' + pad(date.getDate()) + 'T' + pad(date.getHours()) + ':' + pad(date.getMinutes()) + ':' + pad(date.getSeconds());",
          "}",
          "const now = new Date();",
          "const nowPlus5m = new Date(now.getTime() + 5 * 60 * 1000);",
          "const nowPlus30m = new Date(now.getTime() + 30 * 60 * 1000);",
          "const futureArriveAt = new Date(now.getTime() + 130 * 60 * 1000);",
          "const futureCheckoutAt = new Date(now.getTime() + 250 * 60 * 1000);",
          "const futureArriveAt2 = new Date(now.getTime() + 140 * 60 * 1000);",
          "const futureCheckoutAt2 = new Date(now.getTime() + 280 * 60 * 1000);",
          "const walkInCheckoutAt = new Date(now.getTime() + 125 * 60 * 1000);",
          "pm.collectionVariables.set('nowAt', toLocalDateTime(now));",
          "pm.collectionVariables.set('nowPlus5m', toLocalDateTime(nowPlus5m));",
          "pm.collectionVariables.set('nowPlus30m', toLocalDateTime(nowPlus30m));",
          "pm.collectionVariables.set('futureArriveAt', toLocalDateTime(futureArriveAt));",
          "pm.collectionVariables.set('futureCheckoutAt', toLocalDateTime(futureCheckoutAt));",
          "pm.collectionVariables.set('futureArriveAt2', toLocalDateTime(futureArriveAt2));",
          "pm.collectionVariables.set('futureCheckoutAt2', toLocalDateTime(futureCheckoutAt2));",
          "pm.collectionVariables.set('walkInCheckoutAt', toLocalDateTime(walkInCheckoutAt));"
        ]
      }
    }
  ],
